[Unit]
Description=FireCrawlApp Price Tracking Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/firecrawlapp
Environment=PORT=__PORT__
Environment=TZ=Europe/Berlin
ExecStart=/opt/firecrawlapp/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
